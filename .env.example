# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# =========================================================================
# TAPSELL AD NETWORK CREDENTIALS
# Configure in AI Studio Secrets panel or .env file for production release
# =========================================================================
TAPSELL_APP_KEY=NOT_CONFIGURED
TAPSELL_REWARDED_ZONE_ID=NOT_CONFIGURED
TAPSELL_BANNER_ZONE_ID=NOT_CONFIGURED
TAPSELL_INTERSTITIAL_ZONE_ID=NOT_CONFIGURED

# =========================================================================
# CAFE BAZAAR IN-APP BILLING (RSA PUBLIC KEY)
# Obtained from Cafe Bazaar Developer Console under In-App Billing settings
# =========================================================================
BAZAAR_PUBLIC_KEY=NOT_CONFIGURED

